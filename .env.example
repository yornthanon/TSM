JWT_SECRET=
# Neon pooled endpoint example:
# jdbc:postgresql://<project>-pooler.<region>.aws.neon.tech:5432/ticket_db?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ticket_db
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_USERNAME=
# Upstash Redis example: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=redis://localhost:6379
# Kafka is optional/disabled in the monolith deployment.
KAFKA_BOOTSTRAP_SERVERS=
MAIL_FROM=
MAIL_HOST=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_USER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend Vite settings
VITE_API_MODE=live
VITE_API_BASE_URL=http://localhost:8080

# Default admin bootstrap (first deploy only)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@ticketmanagement.com

# API Gateway route mapping for hosted backend services
# Format: internal-host:port=https://your-hosted-url.com (comma-separated)
# Example: user-service:8081=https://api.yourdomain.com/user-service,event-service:8082=https://api.yourdomain.com/event-service,ticket-service:8083=https://api.yourdomain.com/ticket-service,order-service:8084=https://api.yourdomain.com/order-service,payment-service:8085=https://api.yourdomain.com/payment-service,notification-service:8086=https://api.yourdomain.com/notification-service
ROUTE_URI_HOST_MAP=

# Optional: shared secret for service-to-service calls inside the monolith.
# If empty, a random value is generated on each start.
INTERNAL_AUTH_TOKEN=
