# TicketManagement - environment secrets
# Copy to .env and adjust. NEVER commit .env

# JWT (shared by api-gateway + user-service) — REQUIRED, base64, min 512 bits
# Generate with: JwtSecret.generateNewSecret()
JWT_SECRET=

# PostgreSQL
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket123

# Per-service DB creds (override defaults in application.properties)
SPRING_DATASOURCE_USERNAME=ticket
SPRING_DATASOURCE_PASSWORD=ticket123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (SMTP) — used by notification-service
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ticketmanagement.com

# Twilio (SMS) — leave empty to disable SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
