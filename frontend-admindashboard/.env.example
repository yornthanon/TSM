# Admin dashboard environment.
# Copy to `.env` (or `.env.local`) and adjust. Never commit a real `.env`.

# ------------------------------------------------------------------
# Backend location - THE ONLY variable that configures the API host.
# ------------------------------------------------------------------
# This must be the API *root*, ending in `/api/v1`, because every endpoint is
# registered under that prefix. `api.post('/auth/login')` resolves to
# `<VITE_API_BASE_URL>/auth/login`.
#
# Local development, monolith on :8080 (docker compose up):
VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# Local development, api-gateway on :8080 (all microservices running):
# VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# Production when the SPA and API are served from one origin behind a proxy -
# use a relative path so the browser stays same-origin (no CORS, no localhost):
# VITE_API_BASE_URL=/api/v1
#
# Production when the API lives on a different host (CORS must allow this):
# VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
