spring.application.name=api-gateway
server.port=8080

# R2DBC (dynamic routes)
spring.r2dbc.url=${SPRING_DATASOURCE_URL:r2dbc:postgresql://localhost:5432/ticket_gateway_db}
spring.r2dbc.username=${SPRING_DATASOURCE_USERNAME:ticket}
spring.r2dbc.password=${SPRING_DATASOURCE_PASSWORD:ticket123}

# Redis (rate limiting)
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}

# JWT (verify tokens)
jwt.header=Authorization
jwt.prefix=Bearer
jwt.secret=${JWT_SECRET:}
jwt.public-paths=/api/public/**,/health,/actuator/health,/actuator/info
jwt.admin-paths=/api/routes/**,/api/admin/**


gateway.logging.enabled=true
gateway.logging.level=INFO
gateway.logging.log-request-body=false
gateway.logging.log-response-body=true
gateway.logging.log-headers=true
gateway.logging.mask-sensitive-headers=true
gateway.logging.sensitive-headers=authorization,x-api-key,x-auth-token,cookie,set-cookie,x-forwarded-for,x-real-ip,password
gateway.logging.sensitive-fields=password,token,secret,key,credential
gateway.logging.max-body-length=1000
gateway.logging.log-performance=true
gateway.logging.log-error-stack-traces=true
gateway.logging.include-request-id=true
gateway.logging.log-request-metrics=true
gateway.logging.excluded-paths=/health,/actuator/health,/actuator/info
gateway.logging.enable-correlation-id=true
gateway.logging.correlation-id-header=X-Correlation-ID
gateway.logging.log-user-agent=true
gateway.logging.log-client-ip=true
gateway.logging.log-request-size=true
gateway.logging.log-response-size=true
gateway.logging.service-name=api-gateway

# CORS (mobile + web clients)
spring.webflux.cors.allowed-origins=*
spring.webflux.cors.allowed-methods=*
spring.webflux.cors.allowed-headers=*
spring.webflux.cors.allow-credentials=true

# User service configuration
user.service.url=${USER_SERVICE_URL:http://localhost:8081}
PROPS